# ============================================================
# BreatheWay — Environment Configuration
# Warm & community-friendly safe passage through polluted cities
# ============================================================

# Server-side Gemini API Configuration (Private)
GEMINI_API_KEY=your_gemini_api_key_here
PORT=3001
NODE_ENV=development

# Client-Side Firebase Configuration (Public)
# Replace with your actual Firebase Console project settings:
VITE_FIREBASE_API_KEY=AIzaSyExampleKey1234567890
VITE_FIREBASE_AUTH_DOMAIN=breatheway-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=breatheway-app
VITE_FIREBASE_STORAGE_BUCKET=breatheway-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
