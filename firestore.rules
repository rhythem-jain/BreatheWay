rules_version = '2';
// ============================================================
// BreatheWay — Cloud Firestore Security Rules
// Enforces Per-User Isolation & Community Clean Air Pledges
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {
    // Per-user isolated profile and resilience telemetry
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // User routines and personalized telemetry subcollections
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Community pledges public read, authenticated counter increments
    match /community_pledges/{pledgeId} {
      allow read: if true;
      allow update: if request.auth != null;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
